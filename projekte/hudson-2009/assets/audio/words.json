{
 "duration": 77.714,
 "lines": [
  {
   "start": 0.39,
   "end": 5.208,
   "text": "Du sitzt am Fenster eines Airbus in New York. Es ist eiskalt, der Himmel ist klar."
  },
  {
   "start": 5.63,
   "end": 11.945,
   "text": "Um fünfzehn Uhr fünfundzwanzig hebt Flug fünfzehn-neunundvierzig ab. Hundertfünfundfünfzig Menschen sind an Bord."
  },
  {
   "start": 12.44,
   "end": 18.593,
   "text": "Eineinhalb Minuten später: ein Schwarm Kanadagänse. Ein Knall. Dann wird es still."
  },
  {
   "start": 18.9,
   "end": 23.34,
   "text": "Beide Triebwerke sind ausgefallen. Ihr seid nur rund achthundertfünfzig Meter hoch."
  },
  {
   "start": 23.67,
   "end": 26.323,
   "text": "Dem Piloten bleiben jetzt gut dreieinhalb Minuten."
  },
  {
   "start": 26.67,
   "end": 31.924,
   "text": "Der Tower bietet den Rückweg zum Flughafen an. Kapitän Sullenberger rechnet. Das reicht nicht."
  },
  {
   "start": 32.35,
   "end": 34.605,
   "text": "Seine Antwort: „Wir landen im Hudson.“"
  },
  {
   "start": 34.83,
   "end": 39.196,
   "text": "Knapp gleitet ihr über die George-Washington-Brücke. Unter dir nur Wasser."
  },
  {
   "start": 39.47,
   "end": 42.593,
   "text": "„Brace for impact.“ Kopf runter, festhalten."
  },
  {
   "start": 43.27,
   "end": 48.047,
   "text": "Mit rund zweihundertdreißig Stundenkilometern setzt der Airbus auf dem Fluss auf. Er bleibt ganz."
  },
  {
   "start": 48.53,
   "end": 54.614,
   "text": "Du stehst auf der Tragfläche. Das Wasser ist fünf Grad kalt. Nach vier Minuten ist die erste Fähre da."
  },
  {
   "start": 55.23,
   "end": 59.091,
   "text": "Hundertfünfundfünfzig Menschen an Bord. Hundertfünfundfünfzig überleben."
  },
  {
   "start": 59.38,
   "end": 67.6,
   "text": "Warum nicht zurück zum Flughafen? Ohne Schub ist Höhe dein einziger Vorrat. Jede Kurve und jede Sekunde Zögern kostet Höhe."
  },
  {
   "start": 67.93,
   "end": 74.588,
   "text": "Simulationen zeigen später: Nur bei sofortiger Umkehr hätte es gereicht. Für die Entscheidung blieb fast keine Zeit."
  },
  {
   "start": 74.95,
   "end": 77.547,
   "text": "Hättest du in diesen Sekunden richtig entschieden?"
  }
 ],
