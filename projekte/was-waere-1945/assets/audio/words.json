{
 "duration": 71.471,
 "lines": [
  {
   "start": 0.19,
   "end": 8.927,
   "text": "Berlin, Mai neunzehnhundertfünfundvierzig. Stell dir vor, die Kapitulation kommt nie. Hitler überlebt – und gewinnt den Krieg."
  },
  {
   "start": 9.56,
   "end": 15.321,
   "text": "Neunzehnhundertfünfzig. Du wächst in einem Land auf, in dem ein falsches Wort dich ins Lager bringt."
  },
  {
   "start": 15.65,
   "end": 21.126,
   "text": "Zeitungen, Radio, Schule – alles gehört der Partei. Es gibt nur eine Wahrheit."
  },
  {
   "start": 21.62,
   "end": 27.7,
   "text": "Im Osten läuft der Generalplan Ost. Millionen Menschen werden vertrieben, versklavt oder ermordet."
  },
  {
   "start": 28.21,
   "end": 29.806,
   "text": "Und der Holocaust geht weiter."
  },
  {
   "start": 30.55,
   "end": 37.545,
   "text": "Neunzehnhundertsechzig. Berlin heißt jetzt Germania. Unter der Kuppel der Großen Halle könnten sich Wolken bilden."
  },
  {
   "start": 37.89,
   "end": 42.814,
   "text": "Der Frieden bleibt kalt. Das Reich und Amerika bedrohen sich mit Atombomben."
  },
  {
   "start": 43.51,
   "end": 50.224,
   "text": "Neunzehnhundertneunundachtzig. Hitler wäre hundert. Er wäre wohl tot – sein System vielleicht nicht."
  },
  {
   "start": 50.78,
   "end": 58.203,
   "text": "Warum das fast unmöglich war? Die USA bauten mehr Panzer, Flugzeuge und Schiffe als alle Achsenmächte zusammen."
  },
  {
   "start": 58.43,
   "end": 62.428,
   "text": "Und ab August neunzehnhundertfünfundvierzig hatten nur sie die Atombombe."
  },
  {
   "start": 62.74,
   "end": 66.983,
   "text": "Dass es anders kam, verdanken wir Millionen Menschen, die dagegen gekämpft haben."
  },
  {
   "start": 67.32,
   "end": 71.313,
   "text": "Was hättest du getan: mitgemacht – oder Widerstand geleistet?"
  }
 ],
