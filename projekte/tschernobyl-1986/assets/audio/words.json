{
 "duration": 72.516,
 "lines": [
  {
   "start": 0.3,
   "end": 10.909,
   "text": "Pripjat, Sowjetunion. Sechsundzwanzigster April neunzehnhundertsechsundachtzig. Du schläfst. Drei Kilometer entfernt läuft ein Test im Kernkraftwerk Tschernobyl."
  },
  {
   "start": 11.35,
   "end": 16.863,
   "text": "Ein Uhr dreiundzwanzig. Im Reaktor vier steigt die Leistung in Sekunden auf ein Vielfaches."
  },
  {
   "start": 17.33,
   "end": 21.639,
   "text": "Dann explodiert er. Das Dach fliegt weg. Der Kern liegt offen."
  },
  {
   "start": 21.87,
   "end": 25.83,
   "text": "Die Feuerwehr kommt ohne Schutz. Niemand sagt ihnen, was da brennt."
  },
  {
   "start": 26.2,
   "end": 30.078,
   "text": "Am Morgen spielen Kinder draußen. Die Strahlung ist unsichtbar."
  },
  {
   "start": 30.53,
   "end": 36.484,
   "text": "Sechsunddreißig Stunden später kommen Busse. Fast fünfzigtausend Menschen sollen für drei Tage gehen."
  },
  {
   "start": 36.78,
   "end": 38.059,
   "text": "Sie kommen nie zurück."
  },
  {
   "start": 38.47,
   "end": 43.756,
   "text": "Zwei Tage danach schlagen Messgeräte in Schweden Alarm. Erst jetzt erfährt die Welt davon."
  },
  {
   "start": 44.03,
   "end": 49.254,
   "text": "Auch über Deutschland zieht die Wolke. Regen bringt radioaktives Cäsium bis nach Bayern."
  },
  {
   "start": 49.69,
   "end": 56.813,
   "text": "Warum? Der Reaktor hatte einen Konstruktionsfehler. Entsteht mehr Dampf im Kühlwasser, steigt seine Leistung weiter."
  },
  {
   "start": 57.11,
   "end": 63.11,
   "text": "Und als die Steuerstäbe einfahren, beschleunigen ihre Spitzen die Reaktion zuerst – statt sie zu bremsen."
  },
  {
   "start": 63.45,
   "end": 68.787,
   "text": "Heute ist Pripjat eine Geisterstadt. Die Sperrzone wird noch Jahrhunderte belastet sein."
  },
  {
   "start": 69.23,
   "end": 72.398,
   "text": "Was hättest du getan, wenn dir niemand die Wahrheit sagt?"
  }
 ],
